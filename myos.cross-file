[properties]
skip_sanity_check = true

[binaries]
c = ['riscv64-myos-gcc']
cpp = ['riscv64-myos-g++']
ar = ['riscv64-myos-ar']
strip = ['riscv64-myos-strip']
ld = ['riscv64-myos-ld']
ranlib = ['riscv64-myos-ranlib']

[host_machine]
system = 'myos'
cpu_family = 'riscv64'
cpu = 'unknown'
endian = 'little'

[built-in options]
c_args = ['-march=rv64gc', '-mabi=lp64d', '-mcmodel=medany']
cpp_args = ['-march=rv64gc', '-mabi=lp64d', '-mcmodel=medany']
