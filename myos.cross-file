[properties]
skip_sanity_check = true

[binaries]
c   = ['zig', 'cc',  '-target', 'riscv64-freestanding-none', '-mcpu=generic_rv64+m+a+c+zicsr+zifencei']
cpp = ['zig', 'c++', '-target', 'riscv64-freestanding-none', '-mcpu=generic_rv64+m+a+c+zicsr+zifencei', '-nostdinc++']
ar = ['zig', 'ar']
ranlib = ['zig', 'ranlib']
strip = ['riscv64-unkown-elf-strip']

[host_machine]
system = 'myos'
cpu_family = 'riscv64'
cpu = 'unknown'
endian = 'little'

[built-in options]
c_args = ['-mcmodel=medany']
cpp_args = ['-mcmodel=medany']
